{
  "name": "altos-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "assets": "node scripts/sync-assets.mjs",
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "test": "cargo test --manifest-path engine/Cargo.toml",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "thetowersdk": "0.11.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "@playwright/test": "^1.58.0"
  }
}
